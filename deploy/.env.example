# Copy to deploy/.env and fill in before docker compose up
# Never commit real secrets.

POSTGRES_USER=medshift
POSTGRES_PASSWORD=replace_with_long_random_password
POSTGRES_DB=medshift

# Min 32 characters
JWT_KEY=replace_with_long_random_jwt_signing_key_32plus

# Public URL that browsers / Flutter will call (use https://your.domain when Caddy is on)
PUBLIC_API_URL=http://YOUR_ORACLE_PUBLIC_IP:8080

FIREBASE_ENABLED=false
EMAIL_ENABLED=false

# DOMAIN=medshift.example.com
