# App Service Application settings (copy into Azure Portal)
# Not used by docker-compose — reference only for free-tier demo.

Database__Provider=SqlServer
ConnectionStrings__DefaultConnection=Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=MedShift;User ID=YOUR_ADMIN;Password=YOUR_PASSWORD;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Jwt__Issuer=MedShift
Jwt__Audience=MedShiftClients
Jwt__Key=REPLACE_WITH_RANDOM_STRING_AT_LEAST_32_CHARS_LONG
Jwt__ExpiryMinutes=1440
Firebase__Enabled=false
EmailSettings__Enabled=false
PaymentGateway__Provider=Simulated
ASPNETCORE_ENVIRONMENT=Production

# Vercel project env (web):
# NEXT_PUBLIC_API_URL=https://YOUR_APP.azurewebsites.net
